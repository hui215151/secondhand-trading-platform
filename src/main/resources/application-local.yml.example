# 复制本文件为 application-local.yml 后填写真实值；application-local.yml 已被 .gitignore 忽略
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/secondhand?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: "你的MySQL密码"
  redis:
    host: localhost
    port: 6379
    password: ""
    database: 0

# 阿里云 OSS：只有上传商品图片用得到，不填则 /api/goods/upload 会报错
aliyun:
  oss:
    endpoint: oss-cn-hangzhou.aliyuncs.com
    access-key-id: "你的AccessKeyId"
    access-key-secret: "你的AccessKeySecret"
    bucket-name: "你的Bucket名称"
